<?xml version="1.0" encoding="utf-8"?>
<!-- 하단 탭의 아이콘·글자 색 (itemIconTint, itemTextColor에 사용).
     res/color/ 폴더의 selector = "상태에 따라 바뀌는 색". 위에서부터 검사해서 처음 맞는 줄의 색을 씀.
     - 선택된 탭(state_checked): 칸 배경이 진한 녹색(bg_nav_item)이므로 글자·아이콘은 흰색
     - 그 외(선택 안 된 탭): 밝은 탭 바 배경 위이므로 보조 글자색 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/white" android:state_checked="true" />
    <item android:color="@color/bal_text_sub" />
</selector>
