<?xml version="1.0" encoding="utf-8"?>
<!-- 곡 상세 화면 (하단 탭 없음)
     구조: 바깥 FrameLayout(fitsSystemWindows) > 세로 LinearLayout = [상단 바(< 곡 제목)] + [내용(여백 16dp)]
     그래프가 남는 높이를 차지하고(최소 200dp), 나머지(타일·막대·버튼)는 필요한 만큼만 차지함 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bal_primary_dark"
    android:fitsSystemWindows="true">
    <!-- 바깥 FrameLayout 배경 = 진한 녹색(bal_primary_dark).
         fitsSystemWindows 때문에 이 FrameLayout은 상태바·내비게이션바 높이만큼 안쪽 여백을 가져요.
         Android 15+에서는 앱이 상태바 뒤까지 그려지므로, 그 여백 부분에 이 배경색이 보여서 "상태바 색"이 돼요. -->

<!-- 안쪽 내용 전체의 배경 = 화면 배경색(아이보리) -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bal_background"
    android:orientation="vertical">

    <!-- 1. 공통 상단 바: 뒤로가기(<) + 곡 제목 (자바 코드에서 설정) -->
    <include layout="@layout/include_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- 2. 한 줄 정보 (예: "10/23 (금) 13:05 · 테마 8bit · 스케일 펜타토닉") -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bal_text_sub"
            android:textSize="13sp" />

        <!-- 3. BPM 그래프 영역: 남는 세로 공간 차지(weight=1), 최소 200dp.
             연한 배경(bg_panel) 안에 그래프 + 아래쪽 작은 설명 글자 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:minHeight="200dp"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 직접 만든 그래프 Custom View (태그에 패키지 이름까지 전부 적어야 함) -->
            <com.example.balmatchum.BpmGraphView
                android:id="@+id/graph"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="BPM 변화 그래프 (가로: 시간, 세로: BPM)"
                android:textColor="@color/bal_text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 4. 통계 타일 3개 (걷기 화면과 같은 레이아웃) -->
        <include
            layout="@layout/include_stat_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- 5. 재생 막대. 끌어서 원하는 위치로 옮길 수 있음.
             막대 색: progressTint = 채워진 부분(주 색), progressBackgroundTint = 빈 부분(보조 글자색. SeekBar가 빈 부분을 자동으로 반투명하게 그려서 실제로는 연한 회녹색으로 보임),
                      thumbTint = 끌 수 있는 동그라미(주 색) -->
        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:progressBackgroundTint="@color/bal_text_sub"
            android:progressTint="@color/bal_primary"
            android:thumbTint="@color/bal_primary" />

        <!-- 막대 아래: 왼쪽 현재 재생 시간, 오른쪽 전체 길이 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimeNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="@color/bal_text_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/bal_text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 6. 버튼 두 개 가로 배치 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- [다시 듣기 / 일시정지]: 남는 너비 전부, 높이 56dp, 알약 모양(cornerRadius 28dp = 높이 절반), 주 색(기본 버튼).
                 backgroundTint: 평소 주 색, 누르는 동안 진한 녹색 (res/color/btn_primary_bg.xml)
                 textColor     : 녹색 위 글자라서 흰색 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="다시 듣기"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="@color/btn_primary_bg"
                app:cornerRadius="28dp" />

            <!-- [삭제]: 너비 96dp, 테두리만 있는 알약 (OutlinedButton 스타일).
                 지우는 동작이라 강조 색(bal_accent, 테라코타)으로 글자와 테두리를 칠해서 주의를 끌게 함.
                 배경이 투명한 버튼이라 흰 글자 대신 강조 색 글자를 씀 (흰 글자는 아이보리 배경에 묻힘)
                 strokeColor: 테두리 색, rippleColor: 누를 때 퍼지는 물결 효과 색 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="96dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="삭제"
                android:textColor="@color/bal_accent"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:rippleColor="@color/bal_accent"
                app:strokeColor="@color/bal_accent" />
        </LinearLayout>

        <!-- 7. [내보내기 (WAV)]: 곡을 WAV 파일로 만들어 다운로드 폴더에 저장하고 공유할 수 있게 함.
             위 두 버튼과 같은 알약 모양(cornerRadius = 높이 절반 24dp)의 테두리 버튼(OutlinedButton).
             주 버튼([다시 듣기])보다 덜 눈에 띄게 테두리만 칠하고, 글자·테두리는 주 색(녹색)
             (배경이 투명한 버튼이라 흰 글자는 아이보리 배경에 묻힘 → 녹색 글자) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="내보내기 (WAV)"
            android:textColor="@color/bal_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:rippleColor="@color/bal_secondary"
            app:strokeColor="@color/bal_primary" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
