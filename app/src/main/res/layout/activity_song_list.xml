<?xml version="1.0" encoding="utf-8"?>
<!-- 걸음 곡 기록(목록) 화면
     구조: 바깥 FrameLayout(fitsSystemWindows) > 세로 LinearLayout = [상단 바] + [내용(여백 16dp)] + [하단 탭] -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. 공통 상단 바 ("걸음 곡 기록") -->
    <include layout="@layout/include_toolbar" />

    <!-- 가운데 내용 (남는 높이 전부) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- 2. 윗줄: 왼쪽 "저장된 곡 N개" + 오른쪽 정렬 선택 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- weight=1: 남는 가로 공간을 차지 → 정렬 상자는 오른쪽 끝으로 밀림 -->
            <TextView
                android:id="@+id/tvCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="저장된 곡 0개"
                android:textSize="14sp" />

            <!-- 정렬 Spinner를 테두리 상자(bg_outline_box)로 감쌈 (와이어프레임의 "최신순 ▾" 상자) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_outline_box">

                <Spinner
                    android:id="@+id/spSort"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- 3. 곡 목록 (카드형). 남는 세로 공간을 전부 사용.
             divider="@null" + dividerHeight="10dp": 구분선은 그리지 않고 카드 사이를 10dp 띄움
             listSelector 투명: 누를 때 카드 바깥 사각형까지 칠해지는 기본 효과를 없앰 -->
        <ListView
            android:id="@+id/lvSongs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="10dp"
            android:listSelector="@android:color/transparent" />

        <!-- 저장된 곡이 하나도 없을 때만 보이는 안내 문구 (ListView.setEmptyView로 연결) -->
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="아직 저장된 곡이 없어요.\n걷기를 마치면 여기에 곡이 생겨요."
            android:visibility="gone" />

        <!-- 4. 맨 아래 작은 안내 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="항목을 길게 누르면 삭제 확인 대화상자"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 6. 공통 하단 탭 (기록 선택됨) -->
    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
</FrameLayout>
