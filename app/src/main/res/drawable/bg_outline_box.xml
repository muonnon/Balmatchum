<?xml version="1.0" encoding="utf-8"?>
<!-- Spinner(정렬, 스케일)를 감싸는 상자. 와이어프레임처럼 선택 상자가 네모 칸 안에 보이게 함.
     표면색으로 채우고 테두리를 둘러서 "누를 수 있는 칸"처럼 보이게 함 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="@color/bal_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/bal_outline" />
</shape>
