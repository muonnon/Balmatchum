<?xml version="1.0" encoding="utf-8"?>
<!-- 걷기 화면 위쪽 칩("테마 · 8bit")의 배경: 표면색으로 채우고 얇은 테두리를 두른 알약 모양.
     radius 18dp = 높이(36dp)의 절반 → 양 끝이 완전히 둥글어짐.
     글자는 레이아웃에서 bal_text로 지정 (연한 표면색 위에서 잘 보임) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <!-- solid: 안쪽 채우기 색 -->
    <solid android:color="@color/bal_surface" />
    <!-- stroke: 테두리. 표면색과 화면 배경색이 비슷해서 테두리로 경계를 또렷하게 함 -->
    <stroke
        android:width="1dp"
        android:color="@color/bal_outline" />
</shape>
