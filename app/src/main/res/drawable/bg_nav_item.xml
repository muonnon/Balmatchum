<?xml version="1.0" encoding="utf-8"?>
<!-- 하단 탭 한 칸의 배경.
     selector: 상태(state)에 따라 다른 그림을 고르는 drawable. 위에서부터 차례로 검사해서 처음 맞는 것을 씀.
     state_checked="true" = 지금 선택된 탭 → 주 색(녹색)으로 칸 전체를 칠함.
                            그 위의 아이콘·글자는 흰색 (res/color/nav_item_color.xml)
     그 외 = 투명 → 탭 바 배경(bal_surface)이 그대로 보임 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bal_primary" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
