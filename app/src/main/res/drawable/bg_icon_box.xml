<?xml version="1.0" encoding="utf-8"?>
<!-- 곡 카드 왼쪽 44dp 아이콘 자리의 배경: 테두리 있는 둥근 사각형.
     카드 자체가 표면색(bal_surface)이므로, 아이콘 상자는 한 단계 밝은 화면 배경색으로 채워서 카드 안에서 도드라지게 함 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="@color/bal_background" />
    <stroke
        android:width="1dp"
        android:color="@color/bal_outline" />
</shape>
