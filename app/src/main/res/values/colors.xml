<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 전체 색상 팔레트: "흰 배경 + 연한 회녹색(세이지 그린)".
     레이아웃·drawable·테마·자바 코드는 #RRGGBB를 직접 쓰지 않고 여기 이름(@color/bal_xxx)만 참조해요.
     → 색을 바꾸고 싶으면 이 파일의 값만 고치면 앱 전체가 한꺼번에 바뀌어요.
       (이번 팔레트 변경도 이 파일의 값만 바꿨고, 색 이름은 그대로 둬서 다른 파일은 고칠 필요가 없었어요)
     자바 코드에서는 ContextCompat.getColor(context, R.color.bal_xxx)로 꺼내 써요.

     밝기 순서(밝음 → 어두움): background(흰색) → surface → outline → secondary → primary → primary_dark
     → 같은 녹색 계열을 단계별로 진하게 해서, 배경·표면·테두리·강조가 자연스럽게 구분되게 했어요. -->
<resources>
    <!-- 주 색(차분한 회녹색): 상단 바(Toolbar) 배경, 주 버튼(시작/다시 듣기) 배경, 선택된 하단 탭 칸,
         녹색 글자 버튼(내보내기 등 테두리 버튼의 글자·테두리), 비주얼라이저 가운데 점, BPM 그래프 선,
         라디오·스위치 손잡이·막대(SeekBar)·진행 막대의 켜진(채워진) 색.
         흰 글자를 올려도 잘 읽힐 만큼 진한 값으로 골랐어요. -->
    <color name="bal_primary">#5C7C5A</color>

    <!-- 주 색보다 더 진한 녹색: 상태바 영역, 버튼을 누르고 있을 때(눌림 상태), 상단 바 아래 구분선 -->
    <color name="bal_primary_dark">#4A6849</color>

    <!-- 보조 색(중간 밝기 회녹색): 비주얼라이저의 퍼지는 파동 링, BPM 그래프 선 아래 채우기,
         켜진 스위치의 트랙(막대 부분) -->
    <color name="bal_secondary">#9FBC98</color>

    <!-- 화면 배경(흰색): 모든 화면의 바탕, 대화상자 배경, 곡 카드 안 아이콘 상자, 꺼진 스위치 손잡이 -->
    <color name="bal_background">#FFFFFF</color>

    <!-- 표면 색(아주 연한 회녹색): 패널(비주얼라이저·그래프 영역), 카드(곡 목록), 통계 타일, 칩,
         하단 탭 바탕, 정렬·스케일 선택 상자 -->
    <color name="bal_surface">#DDE9D8</color>

    <!-- 테두리·격자 색(bal_surface보다 한 단계 진한 회녹색): 카드·칩·타일·패널 테두리, 화면 구분선,
         BPM 그래프 격자선, 비주얼라이저 안내 동심원.
         배경이 흰색이라 표면색만으로는 경계가 흐릿할 수 있어서, 이 테두리로 경계를 또렷하게 해요. -->
    <color name="bal_outline">#BFD5B8</color>

    <!-- 본문 글자(거의 검은 녹갈색): 배경·카드 위의 일반 글자, 큰 BPM 숫자, 제목 -->
    <color name="bal_text">#2B2E24</color>

    <!-- 보조 글자(진한 회녹색): 설명 글, 날짜, 타일 라벨, 선택 안 된 하단 탭, 그래프 BPM 숫자,
         막대(SeekBar)·진행 막대의 빈 부분, 꺼진 스위치 트랙, 선택 안 된 라디오 동그라미.
         (빈 부분·꺼진 트랙은 반투명하게 그려져서 실제로는 연한 회색빛 녹색으로 보여요) -->
    <color name="bal_text_sub">#566049</color>

    <!-- 강조 색(진한 주황 갈색): 삭제 버튼, 걷는 중 점(비주얼라이저), 그래프의 재생 위치 막대, 오류 색 -->
    <color name="bal_accent">#B85A30</color>

    <!-- 흰색: 녹색 배경(상단 바, 주 버튼, 선택된 하단 탭) 위의 글자와 아이콘 -->
    <color name="white">#FFFFFFFF</color>
</resources>
