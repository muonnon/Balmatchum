<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- allowBackup="false": 앱 데이터(걸음 노래 DB 등)가 기기 백업(adb backup / 클라우드 백업)에 포함되지 않도록 막음 -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Balmatchum">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 걸음 곡 목록 화면. 앱 안에서만 여는 화면이라 exported="false" (다른 앱이 직접 열 수 없음) -->
        <activity
            android:name=".SongListActivity"
            android:exported="false" />
        <!-- 곡 상세 화면. 목록에서 곡을 누르면 열림 -->
        <activity
            android:name=".SongDetailActivity"
            android:exported="false" />
        <!-- 설정 화면. 걷기 화면의 [설정] 버튼으로 열림 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- FileProvider: 앱 안의 파일(내보낸 WAV)을 다른 앱(카카오톡, 드라이브 등)에 안전하게 건네주는 통로.
             파일 경로를 그대로 주면 다른 앱이 읽을 수 없어서(보안), content:// 주소로 바꿔서 줌.
             authorities  : 이 통로의 이름. 앱마다 달라야 해서 패키지 이름(applicationId)을 붙임
             exported=false + grantUriPermissions=true : 아무나 열 수는 없고, 공유할 때 허락한 파일만 읽게 함
             meta-data    : 어느 폴더의 파일을 건넬 수 있는지 (res/xml/file_paths.xml) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>